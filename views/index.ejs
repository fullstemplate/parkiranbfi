<!DOCTYPE html>
<html lang="en">
  <head>
    <link
      rel="icon"
      href="/views/motorbike.png"
      type="image/x-icon"
    />
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Parkiran BFI</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="container">
      <h1 class="p-4 text-primary"><%= title %></h1>
      <form
        action="/add"
        method="post"
        class="row g-3 my-4"
      >
        <h3 class="text-body-tertiary fw-semibold">Masukkan Data harin ini</h3>
        <div class="col-md-3">
          <label
            for="nama"
            class="form-label fw-semibold"
            >Nama</label
          >
          <input
            type="text"
            name="nama"
            class="form-control"
            placeholder="Nama petugas"
          />
        </div>
        <div class="col-md-3 col-sm-200">
          <label
            for="motor"
            class="form-label fw-semibold"
            >Motor</label
          >
          <input
            type="number"
            name="motor"
            class="form-control"
            placeholder="Jumlah motor hari ini"
            min="0"
            max="50"
          />
        </div>
        <div class="col-md-3">
          <label
            for="mobil"
            class="form-label fw-semibold"
            >Mobil</label
          >
          <input
            type="number"
            name="mobil"
            class="form-control"
            placeholder="Jumlah mobil hari ini"
            min="0"
            max="25"
          />
        </div>
        <div class="col-md-3">
          <label
            for="tanggal"
            class="form-label fw-semibold"
            >Tanggal</label
          >
          <input
            type="date"
            name="tanggal"
            id="tanggal"
            class="form-control"
            placeholder="Tanggal hari ini"
          />
          <div
            id="date"
            class="form-text text-"
          >
            Date,month,year
          </div>
        </div>
        <div class="col-md-3">
          <label
            for="isverif"
            class="form-label fw-semibold"
            >kode petugas</label
          >
          <input
            type="text"
            name="kode_admin"
            class="form-control"
            placeholder="Masukkan kode petugas"
            required
          />
        </div>
        <div>
          <button
            type="submit"
            class="btn btn-primary"
          >
            Add
          </button>
        </div>
      </form>
      <table class="table">
        <thead>
          <tr>
            <!-- <th scope="col">id</th> -->
            <th scope="col">Nama Petugas</th>
            <th scope="col">Motor</th>
            <th scope="col">Mobil</th>
            <th scope="col">Tanggal</th>
          </tr>
        </thead>
        <% users.reverse(); %>
        <tbody class="table-group-divider">
          <% for (let user of users) { %>
          <tr>
            <!-- <th scope="row"><%= user.id %></th> -->
            <th scope="row"><%= user.nama %></th>
            <th scope="row"><%= user.motor %></th>
            <th scope="row"><%= user.mobil %></th>
            <th scope="row"><%= user.tanggal %></th>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
